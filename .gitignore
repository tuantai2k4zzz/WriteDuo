# ==========================================
# Root & Monorepo Dependencies
# ==========================================
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env*
**/.env.local
**/.env.*.local
# Giữ lại file mẫu .env.example
!.env.example
!**/.env.example

# ==========================================
# Frontend (Next.js / React) Builds
# ==========================================
.next/
**/.next/
out/
**/out/
build/
**/build/
next-env.d.ts
*.tsbuildinfo

# ==========================================
# Backend (NestJS / Node.js) Builds
# ==========================================
dist/
**/dist/

# ==========================================
# Vercel Deployment Artifacts
# ==========================================
.vercel/
**/.vercel/

# ==========================================
# Logs & Debugging
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
**/coverage/
.nyc_output/

# ==========================================
# OS & System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# IDEs & Code Editors
# ==========================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
